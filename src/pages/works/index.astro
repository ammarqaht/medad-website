---
/* The works gallery (FR-10 to FR-12): an archive of printed folders on two
   shelves, one per arm. `?arm=digital` / `?arm=live` preselects an arm. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Archive from '../../components/works/Archive.astro';
import { worksCopy } from '../../content/works';
import '../../styles/works.css';

const g = worksCopy.gallery;
const [first, last] = g.headline;
---
<BaseLayout title={g.title} description={g.description}>
  <div class="gal wrap">
    <header class="gal__head">
      <h1 class="gal__title display">
        <span data-ink>{first}</span>
        <span class="gal__hl box" data-pop><span data-ink>{last}</span></span>
      </h1>
      <p class="gal__line box" data-pop="0.3">{g.line}</p>
      <span class="gal__tape" aria-hidden="true"></span>
    </header>
    <Archive />
  </div>
</BaseLayout>
