---
/* Phase 1 placeholder home: the approved hero, to prove the foundation.
   The full story (ink-drop opener, ink line, two arms) arrives in phase 2. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site, WHATSAPP } from '../content/site';
import { html } from '../content/brand';

const words = site.home.headline.split(' ');
const last = words.pop();
---
<BaseLayout>
  <section class="hero wrap">
    <div class="hero__text">
      <h1 class="hero__title display">
        {words.join(' ')} <span class="hl">{last}</span>
      </h1>
      <p class="hero__line box" data-pop="0.06">{site.home.line}</p>
      <div class="hero__cta" data-pop="0.14">
        <Button href={WHATSAPP}>{site.home.cta}</Button>
        <Button href="/works" variant="paper">{site.home.works}</Button>
      </div>
    </div>

    <div class="poster box" data-pop="0.1">
      <p class="poster__word" set:html={html(site.home.title)} />
      <div class="drip" aria-hidden="true">
        <svg class="drip__drop" viewBox="0 0 60 84">
          <path d="M30 3 C 30 3, 56 38, 56 56 A 26 26 0 0 1 4 56 C 4 38, 30 3, 30 3 Z" />
          <path class="shine" d="M17 52 C 17 44, 21 37, 25 32" />
        </svg>
        <div class="drip__pool"></div>
      </div>
      <svg class="sticker sticker--star" viewBox="0 0 100 100" aria-hidden="true">
        <path d="M50 2 L58 30 L84 16 L70 42 L98 50 L70 58 L84 84 L58 70 L50 98 L42 70 L16 84 L30 58 L2 50 L30 42 L16 16 L42 30 Z" />
      </svg>
      <span class="sticker sticker--block" aria-hidden="true"></span>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 80px) clamp(56px, 8vw, 104px);
    display: grid;
    gap: clamp(48px, 5vw, 64px);
  }
  .hero__title {
    font-size: clamp(60px, 9.4vw, 140px);
    line-height: 1.12;
    text-wrap: balance;
  }
  .hl {
    display: inline-block;
    padding: 0 .14em .06em;
    margin-inline-start: .04em;
    background: var(--green-500);
    border: var(--bw) solid var(--ink);
    box-shadow: var(--shadow);
    line-height: 1.05;
    rotate: -2deg;
  }
  .hero__line {
    margin-block-start: clamp(24px, 3vw, 36px);
    max-inline-size: 34ch;
    padding: 18px 20px;
    font-size: clamp(19px, 1.7vw, 23px);
    line-height: 1.6;
    rotate: .6deg;
  }
  .hero__cta {
    margin-block-start: clamp(28px, 3vw, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  /* Poster: the brand word with a falling drop of ink */
  .poster {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 5 / 4;
    background: var(--green-500);
    display: grid;
    place-items: center;
  }
  .poster__word {
    position: relative;
    z-index: 2;
    font-size: 30cqi;
    line-height: 1;
    color: var(--ink);
    translate: 0 -10%;
  }
  .drip {
    --fall: 8cqi;
    position: absolute;
    z-index: 1;
    inset-block-end: 7%;
    inset-inline-end: 14%;
    inline-size: 30cqi;
    block-size: 19cqi;
  }
  .drip__drop {
    position: absolute;
    inline-size: 8cqi;
    inset-block-start: 0;
    inset-inline-start: calc(50% - 4cqi);
    overflow: visible;
    transform-origin: 50% 0;
  }
  .drip__drop path { fill: var(--ink); stroke: var(--ink); stroke-width: 3; }
  .drip__drop .shine { fill: none; stroke: var(--green-400); stroke-width: 5; stroke-linecap: square; }
  .drip__pool {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    block-size: 5cqi;
    background: var(--ink);
    border-radius: 50%;
  }
  .sticker { position: absolute; z-index: 3; }
  .sticker--star {
    inline-size: clamp(84px, 24cqi, 150px);
    inset-block-start: -38px;
    inset-inline-start: -10px;
    rotate: 12deg;
    overflow: visible;
    transition: rotate var(--snap);
  }
  .sticker--star path { fill: var(--green-300); stroke: var(--ink); stroke-width: 3; stroke-linejoin: miter; }
  .sticker--block {
    inline-size: 26cqi;
    block-size: 9cqi;
    inset-block-end: -18px;
    inset-inline-start: 10%;
    background: var(--paper);
    border: var(--bw) solid var(--ink);
    box-shadow: var(--shadow);
    rotate: -5deg;
    background-image: repeating-linear-gradient(90deg, var(--ink) 0 3px, transparent 3px 14px);
  }
  .poster:hover .sticker--star { rotate: -12deg; }

  @media (min-width: 600px) and (max-width: 899px) {
    .poster { aspect-ratio: 16 / 10; }
    .poster__word { font-size: 26cqi; }
    .drip { block-size: 17cqi; --fall: 6cqi; }
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 7fr 5fr; align-items: center; }
    .poster { aspect-ratio: 4 / 5; rotate: 2deg; }
    .poster__word { font-size: 36cqi; }
    .drip { inset-block-end: 12%; block-size: 26cqi; --fall: 15cqi; }
  }

  /* The drop grows, falls in hard frames, and the pool splashes */
  :global(.js) .poster:global(.is-in) .drip__drop { animation: drip 3.2s steps(1, end) infinite; }
  :global(.js) .poster:global(.is-in) .drip__pool { animation: pool 3.2s steps(1, end) infinite; }
  @keyframes drip {
    0%   { translate: 0 0; scale: .25; }
    12%  { translate: 0 0; scale: .55; }
    24%  { translate: 0 0; scale: 1; }
    44%  { translate: 0 calc(var(--fall) * .2); scale: 1; }
    52%  { translate: 0 calc(var(--fall) * .55); scale: 1; }
    58%  { translate: 0 calc(var(--fall) * .8); scale: 1 .8; }
    62%  { translate: 0 var(--fall); scale: 0; }
    100% { translate: 0 var(--fall); scale: 0; }
  }
  @keyframes pool {
    0%, 60% { scale: 1 1; }
    62%  { scale: 1.3 1.5; }
    70%  { scale: 1.15 1.2; }
    80%, 100% { scale: 1 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .poster:global(.is-in) .drip__drop,
    :global(.js) .poster:global(.is-in) .drip__pool { animation: none; }
    .drip__drop { translate: 0 calc(var(--fall) * .75); }
    .sticker { transition: none; }
    .poster:hover .sticker--star { rotate: 12deg; }
  }
</style>
