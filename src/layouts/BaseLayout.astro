---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InkFlood from '../components/InkFlood.astro';
import { site, WHATSAPP } from '../content/site';
import { text } from '../content/brand';

interface Props {
  /** Page title; the brand is appended unless this is the home page. */
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.meta.description, noindex = false } = Astro.props;
const brand = text(site.meta.title);
const fullTitle = title ? `${title} · ${brand}` : text(site.meta.homeTitle);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og/medad-og.png', Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://medaad.tech/#org',
  name: 'مداد',
  alternateName: 'Medad',
  url: 'https://medaad.tech/',
  logo: 'https://medaad.tech/logo/apple-touch-icon.png',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', url: WHATSAPP, availableLanguage: ['ar'] },
};
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={text(description)} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#F6F4EF" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={brand} />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={text(description)} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={site.meta.ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={text(description)} />
  <meta name="twitter:image" content={ogImage} />
  {!title && <link rel="preload" href="/logo/medad-mark-paper.webp" as="image" fetchpriority="high" />}
  {!title && <script type="application/ld+json" is:inline set:html={JSON.stringify(org)} />}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/logo/favicon-64.png" type="image/png" />
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/thmanyahserifdisplay-Black.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/thmanyahsans-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline src="/boot.js"></script>
</head>
<body>
  <InkFlood />
  <a class="skip" href="#content">{site.nav.skip}</a>
  <Header />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/base';
  </script>
</body>
</html>
