---
/* A floating way into the works, for visitors who never look at the header.
   It appears once the hero is behind them and steps aside when the closing
   call to contact (or the footer) is on screen, so the two never compete. */
import { site } from '../../content/site';
---
<a class="float" href="/works" data-float aria-hidden="true" tabindex="-1">
  <span>{site.nav.float}</span>
  <span class="float__arrow" aria-hidden="true"></span>
</a>

<style>
  .float {
    position: fixed;
    z-index: 40;
    inset-inline-end: var(--gutter);
    inset-block-end: max(18px, calc(env(safe-area-inset-bottom) + 12px));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-block-size: 48px;
    padding: 10px 20px;
    background: var(--green-500);
    color: var(--ink);
    border: var(--bw) solid var(--ink);
    box-shadow: var(--shadow);
    font-weight: 900;
    font-size: 18px;
    text-decoration: none;
    rotate: -2deg;
    translate: 0 calc(100% + 40px);
    visibility: hidden;
    transition: translate var(--stamp), visibility 0s linear 240ms, box-shadow var(--snap);
  }
  .float:global(.is-shown) {
    translate: 0 0;
    visibility: visible;
    transition: translate var(--stamp), visibility 0s, box-shadow var(--snap);
  }
  .float:global(.is-shown):hover { box-shadow: calc(var(--sx) / 2) calc(var(--off) / 2) 0 0 var(--ink); }
  .float__arrow {
    inline-size: .9em;
    block-size: .9em;
    background: currentColor;
    clip-path: polygon(0 50%, 55% 0, 55% 30%, 100% 30%, 100% 70%, 55% 70%, 55% 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .float, .float:global(.is-shown) { transition: visibility 0s; translate: 0 0; }
  }
</style>

<script>
  /* Shown between the hero and the closing section. */
  const float = document.querySelector<HTMLAnchorElement>('[data-float]');
  const hero = document.querySelector('[data-hero]');
  const ends = document.querySelectorAll('.closing, .footer');
  if (float && hero && 'IntersectionObserver' in window) {
    let heroVisible = true;
    const endVisible = new Set<Element>();
    const update = () => {
      const show = !heroVisible && endVisible.size === 0;
      float.classList.toggle('is-shown', show);
      float.setAttribute('aria-hidden', String(!show));
      float.tabIndex = show ? 0 : -1;
    };
    new IntersectionObserver((e) => {
      heroVisible = e[e.length - 1].isIntersecting;
      update();
    }).observe(hero);
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? endVisible.add(e.target) : endVisible.delete(e.target)));
      update();
    });
    ends.forEach((el) => io.observe(el));
  }
</script>
