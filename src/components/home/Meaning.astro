---
/* What the name means: مداد is ink. A lexicon entry, printed and stamped. */
import { site } from '../../content/site';
import { html } from '../../content/brand';
const { meaning } = site.home;
---
<section class="meaning" aria-labelledby="meaning-title">
  <h2 class="meaning__title display box" id="meaning-title" data-pop set:html={html(meaning.title)} />
  <div class="meaning__entry box" data-pop="0.1">
    <p class="meaning__text" set:html={html(meaning.text)} />
    <svg class="meaning__drop" viewBox="0 0 60 84" aria-hidden="true">
      <path d="M30 3 C 30 3, 56 38, 56 56 A 26 26 0 0 1 4 56 C 4 38, 30 3, 30 3 Z" />
    </svg>
  </div>
</section>

<style>
  .meaning {
    max-inline-size: var(--max);
    margin-inline: auto;
    padding: clamp(40px, 6vw, 88px) var(--gutter);
    display: grid;
    gap: 28px;
  }
  .meaning__title {
    justify-self: start;
    padding: 14px 24px 20px;
    background: var(--green-300);
    font-size: clamp(40px, 6vw, 88px);
    line-height: 1.15;
    rotate: -2deg;
    position: relative;
    z-index: 2;
  }
  .meaning__entry {
    position: relative;
    padding: clamp(24px, 3.4vw, 48px);
    padding-inline-end: clamp(64px, 9vw, 140px);
  }
  .meaning__text { font-size: clamp(21px, 2.3vw, 32px); line-height: 1.65; font-weight: 700; }
  .meaning__text :global(.brand-word) { font-size: 1.12em; }
  .meaning__drop {
    position: absolute;
    inset-block-end: -28px;
    inset-inline-end: clamp(16px, 3vw, 40px);
    inline-size: clamp(44px, 6vw, 80px);
    overflow: visible;
    rotate: 8deg;
  }
  .meaning__drop path { fill: var(--ink); stroke: var(--ink); stroke-width: 3; }
  @media (min-width: 900px) {
    .meaning { grid-template-columns: repeat(12, 1fr); align-items: start; }
    .meaning__title { grid-column: 1 / span 6; margin-block-start: 8px; }
    .meaning__entry { grid-column: 4 / span 9; margin-block-start: -36px; }
  }
</style>
