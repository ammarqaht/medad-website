---
/* Closing (FR-09): the only call to contact on the page, at the very end. */
import Button from '../Button.astro';
import { site, WHATSAPP } from '../../content/site';
const { closing } = site.home;
---
<section class="closing" aria-labelledby="closing-title">
  <div class="closing__slab box" data-pop>
    <h2 class="closing__title display" id="closing-title" data-ink>{closing.headline}</h2>
    <p class="closing__line">{closing.line}</p>
    <Button href={WHATSAPP} variant="paper">{closing.cta}</Button>
    <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="46" /><circle cx="50" cy="50" r="18" />
    </svg>
  </div>
</section>

<style>
  .closing {
    padding: clamp(24px, 4vw, 48px) var(--gutter) clamp(72px, 9vw, 120px);
    max-inline-size: var(--max);
    margin-inline: auto;
  }
  .closing__slab {
    position: relative;
    background: var(--green-500);
    padding: clamp(36px, 7vw, 96px) clamp(22px, 5vw, 72px);
    display: grid;
    justify-items: start;
    gap: clamp(20px, 3vw, 32px);
    box-shadow: calc(var(--sx) * 2) calc(var(--off) * 2) 0 0 var(--ink);
  }
  .closing__title { font-size: clamp(46px, 8.2vw, 124px); line-height: 1.12; max-inline-size: 11ch; position: relative; z-index: 1; }
  .closing__line { font-size: clamp(19px, 1.8vw, 24px); line-height: 1.6; max-inline-size: 34ch; }
  .ring {
    position: absolute;
    inline-size: clamp(90px, 16vw, 200px);
    inset-block-start: clamp(-40px, -3vw, -24px);
    inset-inline-end: clamp(-36px, -2vw, -14px);
    rotate: -14deg;
    overflow: visible;
    transition: rotate var(--snap);
  }
  .ring circle { fill: var(--paper); stroke: var(--ink); stroke-width: 3; }
  .ring circle + circle { fill: var(--ink); }
  .closing__slab:hover .ring { rotate: 24deg; }
  @media (prefers-reduced-motion: reduce) { .ring { transition: none; } .closing__slab:hover .ring { rotate: -14deg; } }
</style>
