---
/* The works archive (FR-10 to FR-12): one Finder-like window per arm. Each
   window shows its folders as desktop icons (shared Folder.astro) and a
   Quick-Look preview of the selected folder: name, one line, sketch, and an
   «افتح» button per work. `?arm=digital` / `?arm=live` preselects an arm.
   Without JS every preview shows and every «افتح» is a plain link. */
import ArchiveWindow from './ArchiveWindow.astro';
import { arms, worksCopy } from '../../content/works';
const g = worksCopy.gallery;
---
<div class="arc" data-archive>
  <div class="arc__filters" role="group" aria-label={g.filtersLabel} data-filters hidden>
    <button type="button" class="chip" data-filter="all" data-name={g.all} aria-pressed="true">{g.all}</button>
    {arms.map((a) => (
      <button type="button" class="chip" data-filter={a.id} data-name={a.name} aria-pressed="false">{a.name}</button>
    ))}
  </div>
  <p class="works-sr" aria-live="polite" data-filter-status data-label={g.showing}></p>

  <div class="arc__windows">
    {arms.map((arm, i) => <ArchiveWindow arm={arm} index={i} />)}
  </div>
</div>

<script>
  import { initArchive } from './archive';
  try {
    initArchive();
  } catch (err) {
    console.error(err);
  }
</script>
