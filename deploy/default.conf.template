# Medad website: static Astro build served by nginx.
# CranL sets $PORT; nginx's template step substitutes it at startup.
# Preview hosts (*.cranl.net) must never be indexed; only medaad.tech is.
map $host $robots_tag {
  default "";
  "~*cranl\.net$" "noindex, nofollow";
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  charset utf-8;
  server_tokens off;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 512;
  gzip_vary on;
  gzip_types text/css text/javascript application/javascript image/svg+xml text/plain application/json application/xml text/xml;

  # add_header in a location replaces any inherited set, so every location
  # includes the security headers itself.

  error_page 404 /404.html;

  # One address: www.medaad.tech redirects to medaad.tech (canonical, OG and
  # sitemap all use the bare domain). HTTPS is terminated at CranL's edge.
  if ($host ~* ^www\.(.+)$) {
    return 301 https://$1$request_uri;
  }

  # Hashed build assets never change under the same name.
  location ^~ /_astro/ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
  }
  # Fonts and logos keep their names across deploys but do not change.
  location ~* \.(woff2|png|webp|ico)$ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=2592000";
    access_log off;
  }
  # Pages and boot.js: always revalidate so a deploy shows at once.
  location / {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/index.html =404;
  }
  location = /404.html {
    include /etc/nginx/snippets/headers.conf;
    internal;
  }
}
